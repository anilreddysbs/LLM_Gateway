# LLM Gateway Environment Configuration Example
# Copy this file to .env and adjust as necessary for your environment.

# Service configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Master Admin Key (Required for /admin/* endpoints)
ADMIN_API_KEY=admin-super-secret-key-change-me

# PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_gateway

# Redis connection string for caching, rate limiting, and circuit breaker
REDIS_URL=redis://localhost:6379/0

# Rate Limiter & Redis Resilience
# If Redis becomes unreachable, fail-open (allow request) or fail-closed (reject with 503)
FAIL_OPEN_ON_REDIS_ERROR=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_TEMPERATURE=0.3
CACHE_ISOLATION_DEFAULT=false

# Resilience and Timeouts
REQUEST_TIMEOUT_SECONDS=30.0
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=15.0
MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Input Validation Limits
MAX_REQUEST_BODY_SIZE_BYTES=2097152
MAX_REQUEST_MESSAGES=100
MAX_REQUEST_TOKENS_CEILING=32768

# Observability and Privacy
# When false, only prompt and completion SHA-256 hashes are logged. Never log full prompts in production.
LOG_PAYLOADS=false
USAGE_LOG_QUEUE_MAX_SIZE=50000
USAGE_LOG_BATCH_SIZE=100
USAGE_LOG_FLUSH_INTERVAL_SECONDS=1.0

# Upstream Provider Keys & Endpoints (Optional if using MockProvider)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

